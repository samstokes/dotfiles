#!/usr/bin/env bash
set -ueo pipefail

usage() {
  local me=$(basename "$0")
  echo "$me [args] [mktemp_args...] -- [xargs_args]"
  echo
  echo "e.g."
  echo "    $me -- ls"
  echo "    $me --read-stdin -- sensible-browser"
  echo "    $me -d 5 -I OUTPUT -- sh -c 'write_to OUTPUT && xdg-open OUTPUT'"
}

declare -a mktemp_args replace_str

delay=0
verbose=
read_stdin=
replace_str=()
suffix=

platform=$(uname)

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | -\? | --help)
      usage
      exit
      ;;
    --)
      shift
      break
      ;;
    -d|--delay)
      shift
      delay="$1"
      ;;
    -r|--read-stdin)
      read_stdin=y
      ;;
    -I)
      shift
      replace_str=(-I "$1")
      ;;
    --tmpdir)
      shift
      if [[ $platform == Darwin ]]; then
        mktemp_args+=(-p "$1")
      else
        mktemp_args+=(--tmpdir="$1")
      fi
      ;;
    --suffix)
      shift
      suffix="$1"
      ;;
    -v|--verbose)
      verbose=y
      ;;
    *)
      mktemp_args+=("$1")
      ;;
  esac
  shift
done

if [[ ${#mktemp_args[@]} -gt 0 ]]; then
  base_tempfile=$(mktemp "${mktemp_args[@]}")
else
  base_tempfile=$(mktemp)
fi
# Linux mktemp supports --suffix natively but Mac does not,
# so implement it here as a portability workaround
if [[ -n $suffix ]]; then
  tempfile="${base_tempfile}${suffix}"
  mv "$base_tempfile" "$tempfile"
else
  tempfile="$base_tempfile"
fi
if [[ -n $verbose ]]; then
  echo tempfile: "$tempfile" >&2
fi

trap "sleep \"$delay\" && rm -f \"$tempfile\"" EXIT

if [[ -n $read_stdin ]]; then
  if [[ -n $verbose ]]; then
    echo Reading from stdin, send EOF to finish: >&2
  fi
  cat > "$tempfile"
  if [[ -n $verbose ]]; then
    echo Done reading from stdin >&2
  fi
fi

if [[ ${#replace_str[@]} -gt 0 ]]; then
  xargs "${replace_str[@]}" "$@" <<<"$tempfile"
else
  xargs "$@" <<<"$tempfile"
fi
